\RequirePackage{tikz}
\RequirePackage{graphicx}


\setbeamertemplate{background}{
    \ifnum\thepage>1\relax%
        \begin{beamercolorbox}[wd=\the\paperwidth,ht=\the\paperheight]{background canvas}
        \end{beamercolorbox}
    \else     
        \vbox to \paperheight{%
            \vfill%
            \hbox to \paperwidth{%
                \hfil %
                \includegraphics[width=0.25\paperwidth]{beamer theme/gvsu.png}%
            }%
            \vspace{1em}%
        }
    \fi
}

\setbeamertemplate{footline}{
    \hbox {%
        \begin{beamercolorbox}[wd=0.9\paperwidth,ht=1em]{footline}%
            \insertdate, \insertinstitute
        \end{beamercolorbox}%
        \begin{beamercolorbox}[wd=0.1\paperwidth,ht=1em]{footline}%
            \centering%
            \insertframenumber / \inserttotalframenumber
        \end{beamercolorbox}%
    }
}


\setbeamertemplate{navigation symbols}{}


\setbeamertemplate{title page}{    
\vfill
\vspace{1em}
\begin{beamercolorbox}[wd=\the\paperwidth, sep=1em]{title page header}
    % \vspace{0.5em}
    \centering
    \usebeamerfont{title}\inserttitle
    % \vspace{0.25em}
\end{beamercolorbox}
\begin{center}
    \vspace{1em}
    Master's Thesis Defense\\
    \vspace{2em}
    \insertauthor\\
    \vspace{1em}
    \insertdate\\
\end{center}
}

\AtBeginSection[]{
    \begin{frame}[plain]{}
        \makebox[\linewidth][c]{%
            \begin{minipage}{\dimexpr\paperwidth\relax}
                \raggedright
                \vbox { %
                    \hbox {
                    \begin{beamercolorbox}[wd=\paperwidth,ht=0.15\paperwidth]{title page header}%
                        \vbox to 0.15\paperwidth{
                            \vfil
                            \centering
                            \usebeamerfont{title}\space\insertsectionhead%
                            \vfil
                        }
                    \end{beamercolorbox}%
                    % \includegraphics[width=0.15\paperwidth,height=0.15\paperwidth]{beamer theme/logo.jpg}%
                    }\nointerlineskip%
                    % \begin{beamercolorbox}[wd=\the\paperwidth,ht=0.5ex]{subtitle} %
                    % \end{beamercolorbox} %
                } %
            \end{minipage}%
        }%
    \end{frame}
}


\setbeamertemplate{frametitle}{
\usebeamerfont{frametitle}\insertframetitle\\
\ifx\insertframesubtitle\@empty%
    % No subtitle, pass %
\else %
    \usebeamerfont{subtitle}\insertframesubtitle\\%
\fi%
\begin{beamercolorbox}[wd=\the\paperwidth,ht=0.2ex]{frametitle}
\end{beamercolorbox}
}