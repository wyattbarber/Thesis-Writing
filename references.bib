	volume = {21},
	issn = {1059924X},
	url = {https://ezproxy.gvsu.edu/login?url=https://search.ebscohost.com/login.aspx?direct=true&AuthType=ip,sso&db=eih&AN=117902092&site=eds-live&scope=site},
	doi = {10.1080/1059924X.2016.1211052},
	shorttitle = {Suicide Among Farmers in France},
	abstract = {Numerous studies have found agricultural workers, including farmers, at elevated risk of suicide, and socioeconomic conditions have been suggested as one of the important determinants of this mortality cause. The real agricultural income per worker in Europe increased steadily from 2005 to 2007 and then fell by 1.8\% in 2008 and by 11.6\% in 2009. This drop was particularly pronounced in France. Repeated cross-sectional studies were conducted to investigate suicide mortality rates among French farmers in 2007{{\textendash}}2009. The study population included all French farmers enrolled yearly in the compulsory Agricultural Social Security and Health Insurance ({CCMSA}). Most of the mean of 500,164 subjects per year were men (68\%). National cause-specific mortality rates were used to calculate standardized mortality ratios ({SMRs}) and associated 95\% confidence intervals (95\% {CIs}) for both genders and for each of the 3 years. During the 3-year study period, 2,769 men and 997 women died. Suicide accounted for 417 of the men's (15\%) and 68 of the women's (6.8\%) deaths. Hanging was the most frequent method of suicide for both. Compared with the general population, the increased rate of suicide deaths among male farmers was 28\% in 2008 and 22\% in 2009. This increased rate was particularly high among those aged 45{{\textendash}}54 years (31\%) and 55{{\textendash}}64 years (47\%) in 2008 (and in the 55{{\textendash}}64-year-old group in 2009 (64\%). Two specific types of farming activity were associated with increased suicide mortality rates in both 2008 and 2009: dairy cattle farming ({SMR} = 1.56 [95\% {CI}: 1.09{{\textendash}}2.15] and {SMR}=1.47 [95\% {CI}: 1.01{{\textendash}}2.04]) and beef cattle farming ({SMR} = 2.27 [95\% {CI}: 1.59{{\textendash}}3.10] and {SMR} = 1.57 [95\% {CI}: 1.01{{\textendash}}2.27]). These results may be useful for a better understanding of the situation from an epidemiological standpoint and for improving suicide prevention policies in this particular population.},
	pages = {310--315},
	number = {4},
	journaltitle = {Journal of Agromedicine},
	publisher = {Taylor \& Francis Ltd},
	author = {Bossard, Claire and Santin, Ga{\"e}lle and Guseva Canu, Irina},
	urldate = {2024-02-11},
	date = {2016-10},
	keywords = {Agriculture, Agricultural income, Agricultural laborers, cattle farming, Causes of death, Confidence intervals, Cross-sectional method, Descriptive statistics, epidemiological surveillance, France, Income, Longitudinal method, mortality, Suicide},
	file = {EBSCO Full Text:C\:\\Users\\wyatt\\Zotero\\storage\\9NSWRYE8\\Bossard et al. - 2016 - Suicide Among Farmers in France Occupational Fact.pdf:application/pdf},
}

