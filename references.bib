	keywords = {Actuators, Mechanical engineering, Polymers, Bioinspired materials},
	file = {Full Text PDF:C\:\\Users\\wyatt\\Zotero\\storage\\EN6UDY97\\Schaffner et al. - 2018 - 3D printing of robotic soft actuators with program.pdf:application/pdf},
}

