	author = {Tan, Chee How and Tze Huan Goh, Jake and Ang, Wei Jun and Le Lee, Jiong and Lin, Ervine Shengwei and Soh, Gim Song and Foong, Shaohui},
	urldate = {2024-06-22},
	date = {2017-11},
	keywords = {Vegetation, Cameras, Ducts, Inspection, Light emitting diodes, Propellers, Visualization},
	file = {IEEE Xplore Abstract Record:C\:\\Users\\wyatt\\Zotero\\storage\\IXTTSIJX\\8274844.html:text/html;IEEE Xplore Full Text PDF:C\:\\Users\\wyatt\\Zotero\\storage\\RNIZXIBZ\\Tan et al. - 2017 - Design and development of micro-aerial vehicle for.pdf:application/pdf},
