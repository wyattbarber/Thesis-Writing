	date = {2024-01-23},
	langid = {english},
	keywords = {Agroecology, Biodiversity, Image processing, Machine learning, Plant breeding},
	file = {Full Text PDF:C\:\\Users\\wyatt\\Zotero\\storage\\V95YWVZX\\Genze et al. - 2024 - Manually annotated and curated Dataset of diverse .pdf:application/pdf},
