	note = {{ISSN}: 2644-3163},
	keywords = {Three-dimensional displays, {UAV}, Perching, Task analysis, Manipulators, Autonomous, Mobile communication, Poles and towers, Power transmission, Unmanned aerial vehicles},
	file = {Full Text PDF:C\:\\Users\\wyatt\\Zotero\\storage\\S2Z82U9E\\von Frankenberg and Nokleby - 2020 - Detection of Long Narrow Landing Features for Auto.pdf:application/pdf;IEEE Xplore Abstract Record:C\:\\Users\\wyatt\\Zotero\\storage\\YBA6G338\\9284856.html:text/html},
}

@article{kominami_detection_2023,
