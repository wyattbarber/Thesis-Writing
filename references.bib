	editor = {Castrignan{\`o}, Annamaria and Buttafuoco, Gabriele and Khosla, Raj and Mouazen, Abdul M. and Moshou, Dimitrios and Naud, Olivier},
	urldate = {2024-02-11},
	date = {2020-01-01},
	keywords = {decision making, Economics, environmental impact, farm perception, innovation, policy trends, regulation, Smart farming},
	file = {ScienceDirect Snapshot:C\:\\Users\\wyatt\\Zotero\\storage\\J3PRZFPS\\B9780128183731000068.html:text/html},
