	langid = {english},
	keywords = {Mechanical engineering, Applied physics, Electrical and electronic engineering, Soft materials},
	file = {Full Text PDF:C\:\\Users\\wyatt\\Zotero\\storage\\XYBBR9U2\\Cacucciolo et al. - 2019 - Stretchable pumps for soft machines.pdf:application/pdf},
}

@article{guo_powerful_2024,
	title = {Powerful {UAV} manipulation via bioinspired self-adaptive soft self-contained gripper},
	volume = {10},
	url = {https://www.science.org/doi/10.1126/sciadv.adn6642},
