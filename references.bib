	file = {EBSCO Full Text:C\:\\Users\\wyatt\\Zotero\\storage\\VDTAKKXB\\Acemoglu and Restrepo - 2020 - Robots and Jobs Evidence from US Labor Markets.pdf:application/pdf},
}

@inproceedings{aghion_direct_2021,
	title = {The Direct and Indirect Effects of Automation on Employment : A Survey of the Recent Literature},
	url = {https://www.semanticscholar.org/paper/The-Direct-and-Indirect-Effects-of-Automation-on-%3A-Aghion/006a9a1c0c0784d617b5b946115f9f1c7d884102},
	shorttitle = {The Direct and Indirect Effects of Automation on Employment},
	abstract = {In this article, we survey the recent literature and discuss two contrasting views on the direct and indirect impacts of automation on employment. A first view predicts that firms that automation reduce employment (a negative {{\textquotedblleft}}direct effect{{\textquotedblright}}), even if this may ultimately result in new job creations taking advantage of the lower equilibrium wage induced by job destructions (a positive {{\textquotedblleft}}indirect effect{{\textquotedblright}}). A second approach emphasizes the market size and business stealing effects of automation. Automating firms become more productive, which enables them to lower their quality-adjusted prices, and therefore to increase the demand for their products. The resulting increase in scale translates into higher employment by automating firms (a positive {{\textquotedblleft}}direct effect{{\textquotedblright}}), potentially at the expense of their competitors (a negative {{\textquotedblleft}}indirect effect{{\textquotedblright}} through business stealing). Drawing from our empirical work on French firm-level data and a growing literature covering multiple countries, we provide empirical support for this second view: automation has a positive direct effect on employment at the firm level. We discuss the implications of these results for the taxation of automation technologies such as robots.},
	author = {Aghion, P.},
	urldate = {2024-02-11},
	date = {2021},
	file = {Full Text PDF:C\:\\Users\\wyatt\\Zotero\\storage\\NQ77LLV8\\Aghion - 2021 - The Direct and Indirect Effects of Automation on E.pdf:application/pdf},
}

@incollection{pedersen_chapter_2020,
