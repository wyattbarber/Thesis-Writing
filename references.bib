	langid = {english},
	file = {Chaisena et al. - 2020 - Automatic Balancing System in Quadcopter with Chan.pdf:C\:\\Users\\wyatt\\Zotero\\storage\\YSX4PLYD\\Chaisena et al. - 2020 - Automatic Balancing System in Quadcopter with Chan.pdf:application/pdf},
}

