	keywords = {Grasping, Drones, Intelligent robots, Manipulators, Power cables, Prototypes, Reliability},
	file = {IEEE Xplore Abstract Record:C\:\\Users\\wyatt\\Zotero\\storage\\P528TNRY\\9341100.html:text/html},
